---
import { Code } from "astro:components";
import fieldConfig from "../../../field-station/streamotter.json";
import LiveCreek from "../components/LiveCreek.astro";
import Base from "../layouts/Base.astro";
import { LINKS, PAGES, RELEASE } from "../site.ts";
import { excerpt } from "../snippets/excerpt.ts";
import handlersSource from "../snippets/handlers.ts?raw";
import subscribeSource from "../snippets/subscribe.ts?raw";

const channelJson = JSON.stringify({ station: fieldConfig.channels.station }, null, 2);
const quickstart = [
  "npm init -y",
  "npm install streamotter",
  "npx streamotter init .",
  "npx streamotter dev --config streamotter.json --handlers server/handlers.mjs"
].join("\n");

const states = [
  { state: "authorizing", text: "Your handler is deciding whether this viewer may have this channel." },
  { state: "synchronizing", text: "Loading a snapshot. Updates that arrive meanwhile are held, then released in revision order." },
  { state: "live", text: "Caught up, with a healthy source. Show it as current." },
  { state: "stale", text: "The connection or the source dropped. Keep showing the last state, marked stale, while StreamOtter recovers." },
  { state: "resync-required", text: "Automatic recovery stopped after three tries. Offer a retry; resync() starts over." },
  { state: "failed", text: "Refused or broken for good, like FORBIDDEN or invalid data. Replace the subscription." }
];
---

<Base
  title="StreamOtter: live state from Kafka to the browser"
  description="StreamOtter is a gateway and TypeScript SDK that takes state from Kafka to the browser. Every view starts from a snapshot, updates in revision order, and says when it's stale."
>
  <section class="hero wrap">
    <p class="eyebrow">StreamOtter {RELEASE} · MIT · Kafka to the browser</p>
    <h1>Live state from Kafka to the browser. <span class="h1-second">Never silently wrong.</span></h1>
    <p class="lede">
      StreamOtter is a gateway and a TypeScript SDK for state that changes. Each view starts from a snapshot, updates in
      revision order, and tells you when it's stale. Your own code decides who may see what.
    </p>
    <div class="cta">
      <a class="button button-primary" href="/field-station/">Walk down the creek</a>
      <button class="install" type="button" data-copy="npm install streamotter" aria-label="Copy the install command">
        <code>npm install streamotter</code><span data-copy-label>Copy</span>
      </button>
      <a class="button button-quiet" href={LINKS.gettingStarted}>Get started</a>
    </div>
  </section>

  <div class="wrap panel">
    <LiveCreek />
    <p class="panel-note">
      A real StreamOtter subscription from this page to the Lontra Creek field station. Lontra Creek is a made-up
      river-otter study: the otters and the weather are simulated, and the data pipeline is real.
    </p>
  </div>

  <div class="wrap facts" aria-label="Facts about this release">
    <span>MIT licensed</span>
    <span>Node.js 24 or later</span>
    <span>Socket.IO 4.8 transport</span>
    <span>Tested with Apache Kafka 4.1.2</span>
    <span><code>{RELEASE}</code> on npm</span>
  </div>

  <section class="section" id="how">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">How it fits together</p>
        <h2>Describe the state, protect it, subscribe to it</h2>
        <p class="lede">
          Browsers subscribe to state channels, not raw topics. You own identity, access rules, and the source of truth;
          StreamOtter owns synchronization, ordering, delivery, and recovery.
        </p>
      </div>
      <ol class="steps">
        <li>
          <div class="step-text">
            <h3>Describe the state</h3>
            <p>
              A channel names one piece of state, its parameters, and its schema. The gateway checks every payload
              against it, and <code>streamotter generate</code> turns it into TypeScript types.
            </p>
          </div>
          <Code code={channelJson} lang="json" theme="night-owl" />
        </li>
        <li>
          <div class="step-text">
            <h3>Decide who sees it</h3>
            <p>
              Your handlers authenticate viewers, authorize each channel, pick state out of Kafka records, and read
              snapshots from your own store. Access is never guessed.
            </p>
          </div>
          <Code code={excerpt(handlersSource)} lang="ts" theme="night-owl" />
        </li>
        <li>
          <div class="step-text">
            <h3>Subscribe in the browser</h3>
            <p>
              The SDK hands you a snapshot, then every newer state in order, plus a state you can show. After a
              disconnect it resynchronizes from a fresh snapshot on its own.
            </p>
          </div>
          <Code code={excerpt(subscribeSource)} lang="ts" theme="night-owl" />
        </li>
      </ol>
    </div>
  </section>

  <section class="section" id="states">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">No silent failures</p>
        <h2>Every view is in a state you can name</h2>
        <p class="lede">
          A view is never reported as live after a disconnect, a restart, or a slow connection. When something goes wrong,
          the state says what, and the error says what to do.
        </p>
      </div>
      <div class="states">
        {states.map(item => (
          <div class="state">
            <span class="chip" data-state={item.state}>{item.state}</span>
            <p>{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="explore">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">At the creek</p>
        <h2>See it work, then see it break</h2>
      </div>
      <div class="explore">
        {PAGES.filter(page => page.href !== "/docs/" && page.href !== "/releases/").map(page => (
          <a class="explore-card" href={page.href}>
            <span class="explore-q">{page.question}</span>
            <span class="explore-title">{page.label}</span>
            <span class="explore-text">{page.summary}</span>
            {!page.ready && <span class="soon">In progress</span>}
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section start" id="start">
    <div class="wrap start-grid">
      <div class="section-head">
        <p class="eyebrow">Five minutes, no Kafka needed</p>
        <h2>Try it on your machine</h2>
        <p class="lede">
          The scaffold uses a built-in fixture source. Open the workbench URL that <code>dev</code> prints, preview a
          channel, and advance the fixture to watch revisions arrive.
        </p>
        <p><a class="button button-primary" href={LINKS.gettingStarted}>Read the getting-started guide</a></p>
      </div>
      <Code code={quickstart} lang="bash" theme="night-owl" />
    </div>
  </section>
</Base>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
    button.addEventListener("click", async () => {
      const label = button.querySelector("[data-copy-label]");
      try {
        await navigator.clipboard.writeText(button.dataset["copy"] ?? "");
        if (label) label.textContent = "Copied";
      } catch {
        if (label) label.textContent = "Select and copy";
      }
      setTimeout(() => {
        if (label) label.textContent = "Copy";
      }, 1800);
    });
  }
</script>

<style>
  .hero {
    padding-block: clamp(48px, 8vw, 96px) 32px;
    display: grid;
    gap: 22px;
  }
  .hero h1 {
    max-width: 16ch;
  }
  .h1-second {
    display: block;
    background: linear-gradient(90deg, #0091f5, #01c4f7 60%, #01e1fc);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    margin-top: 6px;
  }
  .install {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 11px 14px;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
    font: inherit;
  }
  .install code {
    background: none;
    padding: 0;
    font-size: 0.92rem;
  }
  .install span {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--ink-3);
  }
  .install:hover {
    border-color: var(--accent);
  }
  .panel {
    display: grid;
    gap: 12px;
  }
  .panel-note {
    color: var(--ink-3);
    font-size: 0.92rem;
    max-width: 90ch;
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    padding-block: 28px 8px;
    color: var(--ink-2);
    font: 500 0.86rem/1.4 var(--mono);
  }
  .facts span::before {
    content: "";
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 9px;
    border-radius: 50%;
    background: var(--azure);
    vertical-align: middle;
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 18px;
    counter-reset: step;
  }
  .steps li {
    counter-increment: step;
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 28px;
    align-items: start;
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }
  .step-text {
    display: grid;
    gap: 10px;
    align-content: start;
  }
  .step-text::before {
    content: counter(step);
    font: 800 2.2rem/1 var(--display);
    color: var(--azure);
  }
  .step-text p {
    color: var(--ink-2);
  }
  .states {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 14px;
  }
  .state {
    display: grid;
    gap: 10px;
    align-content: start;
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .state .chip {
    justify-self: start;
    font-size: 0.78rem;
    padding: 6px 10px;
  }
  .state p {
    color: var(--ink-2);
    font-size: 0.96rem;
  }
  .explore {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 14px;
  }
  .explore-card {
    position: relative;
    display: grid;
    gap: 8px;
    align-content: start;
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
    transition: border-color 0.15s, transform 0.15s;
  }
  .explore-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .explore-q {
    font: 600 0.72rem/1.3 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .explore-title {
    font: 750 1.25rem/1.2 var(--display);
  }
  .explore-text {
    color: var(--ink-2);
    font-size: 0.95rem;
  }
  .soon {
    justify-self: start;
    margin-top: 4px;
    font: 600 0.66rem/1 var(--mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 5px 7px;
    border-radius: 6px;
    color: var(--stale);
    background: var(--stale-bg);
  }
  .start-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 32px;
    align-items: center;
  }
  .start-grid .section-head {
    margin-bottom: 0;
  }
  @media (max-width: 900px) {
    .steps li,
    .start-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
