  "configVersion": 1,
  "connections": {
    "field": {
      "brokers": [
        "kafka:9094"
      ],
      "sasl": {
        "mechanism": "scram-sha-512",
        "password": {
          "env": "KAFKA_GATEWAY_PASSWORD"
        },
        "username": {
          "env": "KAFKA_GATEWAY_USERNAME"
        }
      },
      "tls": {
        "caFile": "/etc/lontra/kafka/ca.pem"
      }
    }
  },
  "gateway": {
    "allowedOrigins": [
      "https://streamotter.app"
    ],
    "host": "0.0.0.0",
    "path": "/streamotter/socket.io",
    "port": 7400
  },
  "limits": {
    "maxConnections": 300,
    "maxSubscriptionsPerConnection": 12
  },
