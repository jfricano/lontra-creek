---
/** The shared placeholder body for a page whose real content isn't built yet. */
import Mark from "../assets/brand/mark.svg";
import type { Page } from "../site.ts";

interface Props {
  page: Page;
}

const { page } = Astro.props;
---

<section class="wrap upcoming">
  <Mark class="brand upcoming-mark" aria-hidden="true" focusable="false" />
  <p class="eyebrow">{page.question}</p>
  <h1>{page.label}</h1>
  <p class="lede">{page.summary}</p>
  <p class="status"><span class="badge-soon">In progress</span> This page is being built.</p>
  <p><a class="button button-primary" href="/">Back to home</a></p>
</section>

<style>
  .upcoming {
    padding-block: clamp(56px, 10vw, 120px);
    display: grid;
    gap: 18px;
    justify-items: start;
  }
  .upcoming > :not(.upcoming-mark) {
    max-width: 760px;
  }
  /* The mark's viewBox is 434.9 × 317.9. */
  .upcoming-mark {
    display: block;
    height: 72px;
    width: auto;
    aspect-ratio: 434.9 / 317.9;
  }
  .status {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    color: var(--ink-2);
  }
</style>
