---
import Base from "./Base.astro";
import { RELEASE } from "../site.ts";
interface Props { title: string; description: string; noindex?: boolean; csp?: string | undefined; tabletNetwork?: boolean }
const {title,description,noindex=false,csp,tabletNetwork=true}=Astro.props;
---
<Base title={`${title} · StreamOtter`} description={description} noindex={noindex} csp={csp} tabletNetwork={tabletNetwork}>
  <div class="wrap reference">
    <header><p class="eyebrow">StreamOtter <span>v{RELEASE}</span></p><h1>{title}</h1><p class="lede">{description}</p></header>
    <slot />
  </div>
</Base>
<style>
.reference { padding-block:48px 80px; }
header { display:grid;gap:18px;max-width:850px;margin-bottom:40px; }
.eyebrow span {text-transform:none;}
h1 {font-size:clamp(2.5rem,5vw,4rem);}
.reference :global(section) {margin-block:36px;}
.reference :global(h2), .reference :global(h3) {margin-bottom:16px;}
.reference :global(p + p) {margin-top:12px;}
.reference :global(.reference-grid) {display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:18px;}
.reference :global(.reference-card) {padding:22px;border:1px solid var(--line);border-radius:var(--radius);background:var(--surface);}
.reference :global(.table-scroll) {overflow-x:auto;}
.reference :global(table) {width:100%;border-collapse:collapse;text-align:left;font-size:.94rem;}
.reference :global(th),.reference :global(td) {padding:14px;border-bottom:1px solid var(--line);vertical-align:top;}
.reference :global(th) {background:var(--surface-2);}
.reference :global(details) {padding:18px;margin-block:12px;border:1px solid var(--line);border-radius:var(--radius);background:var(--surface);}
.reference :global(summary) {cursor:pointer;font-weight:700;}
.reference :global(details p) {margin-top:14px;}
.reference :global(pre) {overflow:auto;padding:18px;background:var(--code-bg);color:var(--code-ink);border-radius:var(--radius);max-width:100%;}
.reference :global(label) {display:block;font-weight:700;margin-bottom:8px;}
.reference :global(select),.reference :global(textarea) {font:inherit;background:var(--surface);color:var(--ink);border:1px solid var(--line-strong);border-radius:8px;padding:12px;max-width:100%;}
.reference :global(textarea) {width:100%;font:14px/1.5 var(--mono);tab-size:2;}
.reference :global(.notice) {padding:18px;border-left:4px solid var(--accent);background:var(--surface-2);}
</style>
