---
/** The shared placeholder body for a page whose real content isn't built yet. */
import type { Page } from "../site.ts";

interface Props {
  page: Page;
}

const { page } = Astro.props;
---

<section class="wrap upcoming">
  <p class="eyebrow">{page.question}</p>
  <h1>{page.label}</h1>
  <p class="lede">{page.summary}</p>
  <p class="soon">This page is being built. The live panel on the home page already runs on the real field station.</p>
  <p><a class="button button-primary" href="/">Back to the creek</a></p>
</section>

<style>
  .upcoming {
    padding-block: clamp(56px, 10vw, 120px);
    display: grid;
    gap: 18px;
    max-width: 820px;
    margin-inline: auto;
  }
  .soon {
    justify-self: start;
    padding: 10px 14px;
    border-radius: 10px;
    color: var(--stale);
    background: var(--stale-bg);
    font-size: 0.95rem;
  }
</style>
