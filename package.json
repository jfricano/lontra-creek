{
  "name": "lontra-creek",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "StreamOtter's home site and live demo: a fictional river-otter study running on real Kafka.",
  "license": "MIT",
  "engines": {
    "node": ">=24.15"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "test": "node --test --test-force-exit \"packages/*/test/**/*.test.ts\" \"apps/*/test/**/*.test.ts\" \"scripts/test/**/*.test.mjs\"",
    "test:browser": "playwright test",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/site/tsconfig.json --noEmit && tsc -p e2e/tsconfig.json --noEmit",
    "dev:kafka": "node scripts/dev-kafka.mjs",
    "dev:lab": "node scripts/dev-lab.mjs",
    "check:site": "node scripts/check-site.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.6",
    "typescript": "5.9.3"
  }
}
