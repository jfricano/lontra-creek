      "payloadSchema": "CreekOverview",
      "source": "field",
      "version": 1
    },
    "holt": {
      "delivery": {
        "kind": "state",
        "overflow": "resync"
      },
      "handlersRef": "holt",
      "paramsSchema": "HoltParams",
      "payloadSchema": "HoltStatus",
      "source": "field",
      "version": 1
    },
    "notebook": {
      "delivery": {
        "kind": "state",
        "overflow": "resync"
      },
      "handlersRef": "notebook",
      "paramsSchema": "NotebookParams",
      "payloadSchema": "Notebook",
      "source": "notebooks",
      "version": 1
    },
    "otter": {
