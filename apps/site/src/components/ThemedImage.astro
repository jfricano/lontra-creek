---
/**
 * One image with a light-background and a dark-background version. The browser
 * downloads only the one that matches the visitor's color scheme.
 */
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";

interface Props {
  light: ImageMetadata;
  dark: ImageMetadata;
  /** Display width in CSS pixels; 1x and 2x versions are generated. */
  width: number;
  alt: string;
  class?: string;
  loading?: "eager" | "lazy";
}

const { light, dark, width, alt, class: className, loading = "lazy" } = Astro.props;
const [onLight, onDark] = await Promise.all(
  [light, dark].map(src => getImage({ src, width, densities: [1, 2], format: "webp" }))
);
const height = Math.round((light.height * width) / light.width);
---

<picture class={className}>
  <source media="(prefers-color-scheme: dark)" srcset={onDark!.srcSet.attribute} type="image/webp" />
  <img src={onLight!.src} srcset={onLight!.srcSet.attribute} width={width} height={height} alt={alt} loading={loading} decoding="async" />
</picture>
