{
  "name": "@lontra-creek/field-station",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Lontra Creek field station: the demo application that runs the simulation and serves StreamOtter.",
  "license": "MIT",
  "scripts": {
    "configs": "node scripts/configs.ts",
    "validate": "streamotter validate --config streamotter.json",
    "generate": "streamotter generate --config streamotter.json --out src/generated",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@lontra-creek/sim": "0.0.0",
    "kafkajs": "2.2.4",
    "socket.io-client": "4.8.3",
    "streamotter": "file:../../vendor/streamotter-0.2.0-rc.1/streamotter-0.2.0-rc.1.tgz"
  }
}
