---
import Base from "../layouts/Base.astro";
interface Props { title: string; description: string; eyebrow?: string; }
const { title, description, eyebrow = "StreamOtter" } = Astro.props;
---
<Base title={`${title} · StreamOtter`} description={description}>
  <div class="wrap content-page">
    <header class="content-heading"><p class="eyebrow">{eyebrow}</p><h1>{title}</h1><p class="lede">{description}</p></header>
    <slot />
  </div>
</Base>
<style is:global>
.content-page { padding-block: 56px 80px; }
.content-heading { max-width: 820px; margin-bottom: 40px; }
.content-heading h1 { font-size: clamp(2.3rem,5vw,4rem); line-height: 1.08; margin-block: 12px 20px; }
.content-page h2 { margin-block: 28px 14px; }
.content-page h3 { margin-block: 18px 10px; }
.content-page p { margin-block: 10px; }
.content-page pre { overflow-x:auto; max-width:100%; padding:18px; background:var(--code-bg); color:#e9f2fc; border-radius:12px; }
.content-page pre code { background:none; color:inherit; }
.content-page .panel-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:24px; }
.content-page .content-card { padding:24px; background:var(--surface); border:1px solid var(--line); border-radius:16px; min-width:0; }
.content-page .table-scroll { overflow:auto; }
.content-page table { border-collapse:collapse; width:100%; text-align:left; }
.content-page th,.content-page td { padding:12px; border-bottom:1px solid var(--line); vertical-align:top; }
.content-page :is(select,textarea,input) { font:inherit; color:var(--ink); background:var(--surface); border:1px solid var(--line-strong,var(--line)); border-radius:8px; padding:10px; max-width:100%; }
.content-page label { display:block; margin-block:12px 6px; }
.content-page [hidden] { display:none !important; }
.content-page .status-note { padding:14px; border-left:3px solid var(--accent); background:var(--surface); }
@media(max-width:760px) { .content-page .panel-grid { grid-template-columns:1fr; } .content-page { padding-top:32px; } }
</style>
<style is:global>
.content-page .btn { display:inline-flex; align-items:center; justify-content:center; gap:8px; padding:11px 16px; border:1px solid var(--line-strong); border-radius:10px; background:var(--surface); color:var(--ink); cursor:pointer; font:700 .95rem/1.25 var(--body); }
.content-page .btn.primary { background:var(--button-bg); color:var(--button-ink); border-color:transparent; }
.content-page button:disabled { opacity:.55; cursor:not-allowed; }
</style>
