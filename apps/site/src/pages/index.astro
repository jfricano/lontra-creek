---
import { Picture } from "astro:assets";
import { Code } from "astro:components";
import otterMark from "../assets/brand/otter-swim.png";
import fieldConfig from "../../../field-station/streamotter.json";
import LiveCreek from "../components/LiveCreek.astro";
import Base from "../layouts/Base.astro";
import { LINKS, LISTED_PAGES, RELEASE } from "../site.ts";
import { UPCOMING_STABLE } from "../release-facts.ts";
import { excerpt } from "../snippets/excerpt.ts";
import handlersSource from "../snippets/handlers.ts?raw";
import subscribeSource from "../snippets/subscribe.ts?raw";

const channelJson = JSON.stringify({ station: fieldConfig.channels.station }, null, 2);
const quickstart = [
  "npm init -y",
  "npm install streamotter",
  "npx streamotter init .",
  "npx streamotter dev \\",
  "  --config streamotter.json --handlers server/handlers.mjs"
].join("\n");

/** The V1.1 panel: planned behavior from StreamOtter's approved specification, never presented as running here. */
const v11Points = [
  { title: "Preserve the record", text: "A policy can save the original record to a quarantine topic. Only a write Kafka acknowledged counts as saved; until then the source holds." },
  { title: "Continue only under control", text: "Moving past the record needs your application's recovery guard to vouch for its snapshots. Otherwise the source stays held. There is no skip or ignore option." },
  { title: "See each outcome", text: "Whether evidence was saved, whether the source advanced, and whether views resynchronized are reported separately. None stands in for another." }
];

const explorePages = LISTED_PAGES.filter(page => page.href !== "/docs/" && page.href !== "/releases/");

const states = [
  { state: "authorizing", text: "Your handler is deciding whether this viewer may have this channel." },
  { state: "synchronizing", text: "Loading a snapshot. Updates that arrive meanwhile are held, then released in revision order." },
  { state: "live", text: "Caught up, with a healthy source. Show it as current." },
  { state: "stale", text: "The connection or the source dropped. Keep showing the last state, marked stale, while StreamOtter recovers." },
  { state: "resync-required", text: "Automatic recovery stopped after three tries. Offer a retry; resync() starts over." },
  { state: "failed", text: "Refused or broken for good, like FORBIDDEN or invalid data. Replace the subscription." }
];
---

<Base
  title="StreamOtter: live state from Kafka to the browser"
  description="StreamOtter is a gateway and TypeScript SDK that takes state from Kafka to the browser. Every view starts from a snapshot, updates in revision order, and says when it's stale."
>
  <section class="hero wrap">
    <div class="hero-text">
    <p class="eyebrow"><span class="version">v{RELEASE}</span> · MIT</p>
    <h1>Live state from Kafka to the browser. <span class="h1-second">Never silently wrong.</span></h1>
    <p class="lede">
      StreamOtter is an open-source Node.js gateway and TypeScript browser SDK. Browsers subscribe to state channels,
      not raw Kafka topics: each view starts from a snapshot, updates in revision order, and says when it's stale.
      Your handlers decide who sees what.
    </p>
    <div class="cta">
      <a class="button button-primary" href="#live">Try the live demo</a>
      <button class="install" type="button" data-copy="npm install streamotter" aria-label="Copy npm install streamotter">
        <code>npm install streamotter</code><span data-copy-label>Copy</span>
      </button>
      <a class="button button-quiet" href={LINKS.gettingStarted}>Getting started guide ↗</a>
    </div>
    <span class="sr-only" role="status" data-copy-status></span>
    {UPCOMING_STABLE && <p class="release-status"><strong>Release candidate.</strong> The API may change before {UPCOMING_STABLE}. <a href={LINKS.status}>What’s verified in this release →</a></p>}
    </div>
    <Picture
      src={otterMark}
      formats={["avif"]}
      fallbackFormat="webp"
      widths={[360, 560, 820, 1100]}
      sizes="420px"
      alt=""
      loading="eager"
      pictureAttributes={{ class: "hero-otter" }}
    />
  </section>

  <div class="wrap panel">
    <LiveCreek><span slot="tag">DEMO · fictional creek, real Kafka pipeline</span></LiveCreek>
    <p class="panel-note">
      A real StreamOtter subscription from this page to the Lontra Creek field station. Lontra Creek is a made-up
      river-otter study: the otters and the weather are simulated, and the data pipeline is real.
    </p>
  </div>

  <ul class="wrap facts" aria-label="Facts about this release">
    <li><a href={`${LINKS.github}/blob/v${RELEASE}/LICENSE`}>MIT licensed</a></li>
    <li><a href={LINKS.status}>Node.js 24 or later</a></li>
    <li><a href={LINKS.status}>Socket.IO 4.8 transport</a></li>
    <li><a href={LINKS.status}>Tested with Apache Kafka 4.1.2</a></li>
    <li><a href={`${LINKS.npm}/v/${RELEASE}`}><code>{RELEASE}</code> on npm</a></li>
  </ul>

  <section class="section" id="how">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">How it fits together</p>
        <h2>Describe the state, protect it, subscribe to it</h2>
        <p class="lede">
          Browsers subscribe to state channels, not raw topics. You own identity, access rules, and the source of truth;
          StreamOtter owns synchronization, ordering, delivery, and recovery.
        </p>
      </div>
      <ol class="steps">
        <li>
          <div class="step-text">
            <h3>Describe the state</h3>
            <p>
              A channel names one piece of state, its parameters, and its schema. The gateway checks every payload
              against it, and <code>streamotter generate</code> turns it into TypeScript types.
            </p>
          </div>
          <div class="code-frame"><Code code={channelJson} lang="json" theme="night-owl" /></div>
        </li>
        <li>
          <div class="step-text">
            <h3>Decide who sees it</h3>
            <p>
              Your handlers authenticate viewers, authorize each channel, pick state out of Kafka records, and read
              snapshots from your own store. Access is never guessed.
            </p>
          </div>
          <div class="code-frame"><Code code={excerpt(handlersSource)} lang="ts" theme="night-owl" /></div>
        </li>
        <li>
          <div class="step-text">
            <h3>Subscribe in the browser</h3>
            <p>
              The SDK hands you a snapshot, then every newer state in order, plus a state you can show. After a
              disconnect it resynchronizes from a fresh snapshot on its own.
            </p>
          </div>
          <div class="code-frame"><Code code={excerpt(subscribeSource)} lang="ts" theme="night-owl" /></div>
        </li>
      </ol>
      <p class="code-caption">Code samples are type-checked against <code>streamotter@{RELEASE}</code>.</p>
    </div>
  </section>

  <section class="section" id="states">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">No silent failures</p>
        <h2>Every view is in a state you can name</h2>
        <p class="lede">
          A view is never reported as live after a disconnect, a restart, or a slow connection. When something goes wrong,
          the state says what, and the error says what to do.
        </p>
      </div>
      <div class="states">
        {states.map(item => (
          <div class="state" data-state={item.state}>
            <span class="chip" data-state={item.state}>{item.state}</span>
            <p>{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="next-release" aria-labelledby="next-release-title" data-v11-panel>
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Planned for StreamOtter V1.1 · not in <span class="version">{RELEASE}</span></p>
        <h2 id="next-release-title">Next: give a bad record a visible fate</h2>
        <p class="lede">
          StreamOtter V1.1 is specified, not released. It plans failure policies that keep a bad Kafka record as evidence
          and let the stream move on only when your application can show its snapshots cover what that record would have changed.
        </p>
      </div>
      <ul class="v11-points">
        {v11Points.map(point => (
          <li><h3>{point.title}</h3><p>{point.text}</p></li>
        ))}
      </ul>
      <div class="v11-today">
        <p>
          <strong>What runs today.</strong> In <code>streamotter@{RELEASE}</code>, which this site runs, a bad record pauses its
          source: it is never committed or skipped, views go stale, and <code>resumeSource()</code> retries the same record after a fix.
          The Failure Lab's Fouled sensor shows that on a real bench. Its other source-failure exercises are listed with the reason each
          one can't run yet.
        </p>
        <p class="v11-links">
          <a class="button button-primary" href="/lab/#source-failures">Try source failures</a>
          <a href="/when-it-breaks/#source-failure-policies">How V1.1 plans to handle each failure →</a>
        </p>
      </div>
    </div>
  </section>

  {explorePages.length > 0 && <section class="section" id="explore">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">See it run</p>
        <h2>See it work, then see it break</h2>
      </div>
      <div class="explore">
        {explorePages.map(page => (
          <a class="explore-card" href={page.href}>
            <span class="explore-q">{page.question}</span>
            <span class="explore-title">{page.label}</span>
            <span class="explore-text">{page.summary}</span>
            {!page.ready && <span class="badge-soon">In progress</span>}
          </a>
        ))}
      </div>
    </div>
  </section>}

  <section class="section" id="workbench-preview">
    <div class="wrap">
      <div class="section-head"><p class="eyebrow">Included with the CLI</p><h2>See the contract and the state</h2><p class="lede">Preview a channel with the real SDK, inspect its delivery state, and trace records through your local gateway.</p><a href="/workbench/">Tour the workbench →</a></div>
      <a href="/workbench/"><img class="workbench-shot" src="/recordings/workbench/preview.png" alt="Recorded local workbench Preview: jobProgress receives snapshot revision 1 and enters live." loading="lazy" width="1280" height="963" /></a>
      <p class="code-caption">Recording · September 27, 2026 · streamotter@{RELEASE} · local fixture project, not the hosted demo.</p>
    </div>
  </section>

  <section class="section start" id="start">
    <div class="wrap start-grid">
      <div class="section-head">
        <p class="eyebrow">Five minutes, no Kafka needed</p>
        <h2>Try it on your machine</h2>
        <p class="lede">
          The scaffold uses a built-in fixture source. Open the workbench URL that <code>dev</code> prints, preview a
          channel, and advance the fixture to watch revisions arrive.
        </p>
        <p><a class="button button-primary" href={LINKS.gettingStarted}>Read the getting-started guide</a></p>
      </div>
      <div class="code-frame"><Code code={quickstart} lang="bash" theme="night-owl" /></div>
    </div>
  </section>
</Base>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
    button.addEventListener("click", async () => {
      const label = button.querySelector("[data-copy-label]");
      const status = document.querySelector("[data-copy-status]");
      try {
        await navigator.clipboard.writeText(button.dataset["copy"] ?? "");
        if (label) label.textContent = "Copied";
        if (status) status.textContent = "Install command copied.";
      } catch {
        if (label) label.textContent = "Select and copy";
        const code = button.querySelector("code");
        if (code) {
          const range = document.createRange();
          range.selectNodeContents(code);
          const selection = window.getSelection();
          selection?.removeAllRanges();
          selection?.addRange(range);
        }
        if (status) status.textContent = "Clipboard unavailable. The install command is selected; copy it manually.";
      }
      setTimeout(() => {
        if (label) label.textContent = "Copy";
        if (status) status.textContent = "";
      }, 1800);
    });
  }
</script>

<style>
  .hero {
    padding-block: clamp(28px, 3vw, 44px) 28px;
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: 32px;
    align-items: center;
  }
  .hero-text {
    display: grid;
    gap: 18px;
  }
  .hero :global(.hero-otter img) {
    display: block;
    width: 100%;
    height: auto;
    max-width: 420px;
  }
  .hero :global(.hero-otter) {
    background: radial-gradient(ellipse, rgba(4, 141, 252, 0.13), transparent 70%);
  }
  @media (max-width: 999px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
    }
    .hero :global(.hero-otter) {
      display: none;
    }
  }
  .hero h1 {
    max-width: none;
    text-wrap: initial;
    font-size: clamp(2.6rem, 5.2vw, 4.25rem);
  }
  .h1-second {
    display: block;
    background: linear-gradient(90deg, #0369c9, #0086d1);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    margin-top: 6px;
  }
  .install {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 11px 14px;
    border-radius: 12px;
    border: 1px solid var(--line-strong);
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
    font: inherit;
  }
  .install code {
    background: none;
    padding: 0;
    font-size: 0.92rem;
  }
  .install span {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--ink-3);
  }
  .install:hover {
    border-color: var(--accent);
  }
  .panel {
    display: grid;
    gap: 12px;
  }
  .panel-note {
    color: var(--ink-3);
    font-size: 0.92rem;
    max-width: 90ch;
  }
  .facts {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    padding-block: 28px 8px;
    color: var(--ink-2);
    font: 500 0.86rem/1.4 var(--mono);
  }
  .facts li::before {
    content: "—";
    display: inline-block;
    margin-right: 9px;

    vertical-align: middle;
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 18px;
    counter-reset: step;
  }
  .steps li {
    counter-increment: step;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 28px;
    align-items: start;
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }
  .step-text {
    display: grid;
    gap: 10px;
    align-content: start;
  }
  .step-text::before {
    content: counter(step);
    font: 800 2.2rem/1 var(--display);
    color: var(--azure);
  }
  .step-text p {
    color: var(--ink-2);
  }
  .states {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }
  .state {
    display: grid;
    gap: 10px;
    align-content: start;
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .state .chip {
    justify-self: start;
    font-size: 0.78rem;
    padding: 6px 10px;
  }
  .state p {
    color: var(--ink-2);
    font-size: 0.96rem;
  }
  .explore {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 14px;
  }
  .explore-card {
    grid-column: span 2;
    position: relative;
    display: grid;
    gap: 8px;
    align-content: start;
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
    transition: border-color 0.15s, transform 0.15s;
  }
  .explore-card:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  @media (hover: hover) {
  .explore-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  }
  .explore-q {
    font: 600 0.75rem/1.3 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .explore-title {
    font: 750 1.25rem/1.2 var(--display);
  }
  .explore-text {
    color: var(--ink-2);
    font-size: 0.95rem;
  }
  .start-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 32px;
    align-items: start;
  }
  .start-grid .section-head {
    margin-bottom: 0;
  }
  @media (max-width: 900px) {
    .steps li,
    .start-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .code-frame { position: relative; min-width: 0; }
  .code-frame::after {
    content: ""; position: absolute; inset: 1px 1px 1px auto; width: 12px;
    border-radius: 0 var(--radius) var(--radius) 0; pointer-events: none;
    background: linear-gradient(90deg, transparent, var(--code-bg));
  }
  .v11-points {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }
  .v11-points li {
    display: grid;
    gap: 8px;
    align-content: start;
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .v11-points p { color: var(--ink-2); font-size: 0.96rem; }
  .v11-today {
    display: grid;
    gap: 14px;
    margin-top: 18px;
    padding: 20px;
    border-left: 3px solid var(--accent);
    background: var(--surface-2);
    border-radius: 0 var(--radius) var(--radius) 0;
  }
  .v11-today p { max-width: 90ch; color: var(--ink-2); }
  .v11-links { display: flex; flex-wrap: wrap; gap: 12px 20px; align-items: center; }
  @media (max-width: 900px) {
    .v11-points { grid-template-columns: minmax(0, 1fr); }
  }
  .workbench-shot { width:100%;height:auto;display:block;border:1px solid var(--line);border-radius:var(--radius); }
  .version { text-transform: none; }
  .release-status, .code-caption { color: var(--ink-3); font-size: 0.88rem; }
  .code-caption { margin-top: 18px; }
  .facts a { color: inherit; }
  #states, .start { background: var(--surface); }
  .state { border-top: 3px solid var(--sync); }
  .state[data-state="live"] { border-top-color: var(--live); }
  .state[data-state="stale"] { border-top-color: var(--stale); }
  .state[data-state="resync-required"] { border-top-color: var(--resync); }
  .state[data-state="failed"] { border-top-color: var(--failed); }
  .explore-card:nth-child(-n+2) { grid-column: span 3; }
  @media (prefers-color-scheme: dark) {
    .h1-second { background-image: linear-gradient(90deg, #52b8ff, #04bdfd); }
  }
  @media (max-width: 900px) {
    .states { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .explore-card { grid-column: span 3; }
    .explore-card:last-child { grid-column: 1 / -1; }
  }
  @media (max-width: 560px) {
    .cta { display: grid; }
    .cta > * { width: 100%; justify-content: center; }
    .states, .explore { grid-template-columns: minmax(0, 1fr); }
    .explore-card, .explore-card:nth-child(-n+2) { grid-column: auto; }
    .steps li { padding: 18px; }
    .steps :global(pre.astro-code) { margin-inline: -18px; border-radius: 0; }
  }
  @media (forced-colors: active) {
    .h1-second { background: none; color: CanvasText; }
  }
</style>
